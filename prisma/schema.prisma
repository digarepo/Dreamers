generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DepositStatement {
  dp_id           String   @id @db.VarChar(255)
  deposit_date    DateTime?
  owner_name      String?  @db.VarChar(100)
  depositor_name  String?  @db.VarChar(100)
  reconciliation  String?  @db.VarChar(255)
  ref_number      String?  @db.VarChar(20)
  deposit_amount  Decimal? @db.Decimal(10,2)
  bank_name       String?  @db.VarChar(100)
  account_type    String?  @db.VarChar(50)
  comment         String?  @db.VarChar(255)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@map("deposit_statements")
}

model FinancialNote {
  id           Int        @id @default(autoincrement())
  statements   Statements[]
}

model Statements {
  id               Int      @id @default(autoincrement())
  financial_note_id Int
  description      String   @db.VarChar(255)
  amount           Decimal  @db.Decimal(10,2)
  status           String   @default("pending") @db.Enum("pending", "approved", "rejected")
  version          Int      @default(1)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  financial_note   FinancialNote @relation(fields: [financial_note_id], references: [id], onDelete: Cascade)
  
  @@index([financial_note_id], name: "idx_statements_financial_note_id")
  @@index([status], name: "idx_statements_status")
}
